# Shared policy for every response. Do not send no-transform: it disables
# Cloudflare Brotli/gzip.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-6/lDn0xshwwIdFiviT36lhDZQxItdZkQnABbj/b+fZY=' 'sha256-T2FaiJxPMbPplCQ9NvpfutF2hh7PnPH+itTVMMxcrWY=' 'sha256-8lrMcQIDarerf5hQOPQ4FXAuydge4yZHeyBISfuars8=' 'sha256-U+EtjN2h1pHdUkMQtmF1wsO59Q2kVdcFu/XWDMEqHck=' 'sha256-BHPriR7a5BbXhcYLob73XHbEmzA6GoM/cCLzguVJsdU=' 'sha256-JTY9QtRu9eVxwoSI6vb1cLN91O5wfGxqHCj5LhGrI6I='; script-src-attr 'none'; style-src 'self' 'sha256-o4ujq8wbAHuPBtE7EsYgsY74rLK6pOzd9l2qyYddJAw='; style-src-attr 'none'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# HTML stays revalidated and compressible.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Extensionless guide pages.
/website-to-apk
  Cache-Control: public, max-age=0, must-revalidate

/website-to-desktop-app
  Cache-Control: public, max-age=0, must-revalidate

/pwabuilder-alternative
  Cache-Control: public, max-age=0, must-revalidate

/apk-signing
  Cache-Control: public, max-age=0, must-revalidate

# The not-found page must stay revalidated too.
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Non-hashed discovery files revalidate.
/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/index.md
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/ai-catalog.json
  Cache-Control: public, max-age=0, must-revalidate

/og.png
  Cache-Control: public, max-age=86400, must-revalidate

/.well-known/ai-catalog.json
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/security.txt
  Cache-Control: public, max-age=0, must-revalidate

# Large shell inputs and the manifest revalidate.
/shell.apk
  Cache-Control: public, max-age=0, must-revalidate

/shells.json
  Cache-Control: public, max-age=0, must-revalidate

/shells/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output is immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/wasm/*
  Cache-Control: public, max-age=31536000, immutable
