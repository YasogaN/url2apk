{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-to-apk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
