{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-to-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "routes": [
    {
      "pattern": "url2app.yasogan.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // There is no client-side router, so a missing path is a real 404 rather
    // than a 200 response with the landing page.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/favicon"]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
